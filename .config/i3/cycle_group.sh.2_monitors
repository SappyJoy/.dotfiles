#!/bin/bash
direction=$1

# Get current workspace info
readarray -t current < <(i3-msg -t get_workspaces | jq -r '.[] | select(.focused).num, select(.focused).output')
current_ws=${current[0]}
current_output=${current[1]}

# Calculate current group (2 workspaces per group)
current_group=$(( (current_ws - 1) / 2 ))

# Determine new group with bounds (0-4 for 5 groups)
if [ "$direction" = "next" ]; then
    new_group=$(( (current_group + 1) % 5 ))
else
    new_group=$(( (current_group - 1 + 5) % 5 ))
fi

# Calculate target workspaces
ws_dp2=$(( (new_group * 2) + 1 ))  # Odd numbers on DP-2
ws_dp1=$(( (new_group * 2) + 2 ))  # Even numbers on DP-1

if [ "$current_output" = "DP-2" ]; then
    target_ws=$ws_dp2
else
    target_ws=$ws_dp1
fi


# Determine execution order based on current monitor
if [ "$current_output" = "DP-2" ]; then
    # Current is DP-2: switch DP-1 first, then DP-2 (will focus DP-2)
    i3-msg "workspace number $ws_dp2; workspace number $ws_dp1; workspace number $target_ws"
else
    # Current is DP-1: switch DP-2 first, then DP-1 (will focus DP-1)
    i3-msg "workspace number $ws_dp1; workspace number $ws_dp2; workspace number $target_ws"
fi
