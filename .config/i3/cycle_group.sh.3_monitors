#!/bin/bash
direction=$1

# Get current workspace number and output
readarray -t current < <(i3-msg -t get_workspaces | jq -r '.[] | select(.focused).num, select(.focused).output')
current_ws=${current[0]}
current_output=${current[1]}

# Hardcoded monitor configuration (sorted by X position)
MONITORS=("DP-4" "DP-0" "DP-2")
GROUP_SIZE=3  # 3 monitors = 3 workspaces per group
TOTAL_GROUPS=5

# Calculate current group (0-4)
current_group=$(( (current_ws - 1) / GROUP_SIZE ))

# Determine new group
case "$direction" in
    next) new_group=$(( (current_group + 1) % TOTAL_GROUPS )) ;;
    prev) new_group=$(( (current_group - 1 + TOTAL_GROUPS) % TOTAL_GROUPS )) ;;
    *) exit 1 ;;
esac

# Calculate target workspaces for each monitor
declare -A targets
for i in {0..2}; do
    targets["${MONITORS[$i]}"]=$(( new_group * GROUP_SIZE + i + 1 ))
done

# Determine execution order based on current monitor
case "$current_output" in
    "DP-0")  # Leftmost monitor
        i3-msg "workspace ${targets[DP-4]}; \
                workspace ${targets[DP-2]}; \
                workspace ${targets[DP-0]}; \
                workspace ${targets[DP-0]}" >/dev/null
        ;;
    "DP-2")  # Middle monitor
        i3-msg "workspace ${targets[DP-4]}; \
                workspace ${targets[DP-0]}; \
                workspace ${targets[DP-2]}; \
                workspace ${targets[DP-2]}" >/dev/null
        ;;
    "DP-4")  # Rightmost monitor
        i3-msg "workspace ${targets[DP-2]}; \
                workspace ${targets[DP-0]}; \
                workspace ${targets[DP-4]}; \
                workspace ${targets[DP-4]}" >/dev/null
        ;;
esac
